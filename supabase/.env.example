SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Until a real model API is supplied, set true only in local/demo environments.
AI_MOCK_MODE=true
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_CHAT_MODEL=
MODEL_FAST_MODEL=
MODEL_EMBEDDING_MODEL=text-embedding-v4
MODEL_EMBEDDING_DIMENSIONS=1024
MODEL_TIMEOUT_MS=45000

# Alibaba Cloud Model Studio speech services (Beijing workspace domain).
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_BASE_URL=
ASR_MODEL=fun-asr-realtime
TTS_MODEL=cosyvoice-v3-flash
TTS_VOICE=longanyang
SPEECH_MOCK_TEXT=昨晚两点才睡，今天潮热五次

# Comma-separated exact origins. Localhost is added automatically in local mode.
ALLOWED_ORIGINS=http://localhost:3000
